/*
 * Sensai chat app stylesheet.
 */

Screen {
    layout: vertical;
    background: $background;
}

#transcript {
    height: 1fr;
    padding: 0 3 1 3;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-color: $panel-lighten-1;
    scrollbar-color-hover: $primary-muted;
    scrollbar-color-active: $primary;
}

UserMessage {
    margin: 1 0 0 0;
    padding: 0 1;
    border-left: outer $accent;
    background: $boost;
    color: $foreground;
    text-style: bold;
}

AssistantMessage {
    margin: 1 0 0 0;
    padding: 0 1 0 2;
    background: transparent;

    MarkdownParagraph {
        margin: 0 0 1 0;
    }

    MarkdownH1, MarkdownH2, MarkdownH3 {
        margin: 0 0 1 0;
        color: $primary;
        background: transparent;
    }

    MarkdownFence {
        margin: 0 0 1 0;
        border-left: outer $primary-muted;
        background: $surface;
    }

    MarkdownBlockQuote {
        border-left: outer $accent-muted;
        background: transparent;
        color: $text-muted;
    }
}

ReasoningGroup {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1 0 2;
    border-left: outer $primary-muted;
    color: $text-muted;

    .reasoning-header {
        height: 1;
        color: $text-muted;
        text-style: bold;

        &:hover {
            color: $foreground;
        }
    }

    .reasoning-body {
        height: auto;
        padding: 0 0 0 1;
    }

    &.-collapsed .reasoning-body {
        display: none;
    }
}

ThoughtStep {
    height: auto;

    .thought-title {
        color: $accent;
        text-style: italic;
    }

    .thought-live, .thought-summary, .thought-full {
        display: none;
        color: $text-muted;
        text-style: italic;
    }

    .thought-full {
        padding: 0;
        margin: 0;
        background: transparent;
        text-style: none;
    }

    &.-streaming .thought-live {
        display: block;
    }

    &.-done .thought-summary {
        display: block;
    }
}

ReasoningGroup.-full ThoughtStep.-done {
    .thought-summary {
        display: none;
    }

    .thought-full {
        display: block;
    }
}

ToolCallLine {
    margin: 0;
    padding: 0 1 0 2;
    color: $text-muted;
}

ErrorMessage {
    margin: 1 0 0 0;
    padding: 0 1;
    border-left: outer $error;
    background: $error-muted;
    color: $text-error;
}

HintMessage {
    margin: 1 0 0 0;
    padding: 0 1;
    color: $text-disabled;
    text-style: italic;
}

#command-menu {
    margin: 0 2;
    padding: 0 1;
    border: none;
    background: $background;
    color: $text-muted;
    scrollbar-size-vertical: 1;

    & > .option-list--option-highlighted {
        color: $accent;
        background: $boost;
    }
}

#prompt {
    margin: 0 2;
    padding: 0 1;
    border: round $panel-lighten-2;
    background: $background;
    /* the companion, drawn in the top border (see companion.py) */
    border-title-align: right;
    border-title-color: $accent;

    &:focus {
        border: round $accent;
        background-tint: $foreground 3%;
    }

    /* dims the text only: the companion stays bright while it works */
    &:disabled {
        border: round $panel;
        color: $text-muted;
    }

    & > .input--placeholder {
        color: $text-disabled;
        text-style: italic;
    }
}

#statusbar {
    height: 1;
    background: $background;
}

#status {
    width: 1fr;
    height: 1;
    padding: 0 3;
    color: $text-muted;
    background: $background;
}

#persona, #effort {
    height: 1;
    background: $background;
}

.panel {
    height: auto;
    max-height: 60%;
    margin: 0 2;
    padding: 0 1;
    border: round $primary-muted;
    border-title-color: $foreground;
    border-title-style: bold;
    border-subtitle-align: left;
    border-subtitle-color: $text-disabled;
    border-subtitle-style: italic;
    background: $background;

    .panel-empty {
        color: $text-disabled;
        text-style: italic;
    }
}

#mcp-panel {
    .mcp-url {
        padding: 0 0 0 2;
        color: $text-muted;
    }
}

#usage-panel {
    .usage-title {
        margin: 1 0 0 0;
    }
    .usage-title:first-of-type {
        margin: 0;
    }
    .usage-row {
        padding: 0 0 0 2;
    }
}

#sessions-panel {
    #sessions-list {
        height: auto;
        max-height: 20;
        text-wrap: nowrap;
        text-overflow: ellipsis;
        padding: 0;
        border: none;
        background: $background;
        scrollbar-size-vertical: 1;
    }
}

#tools-panel {
    #tools-header {
        height: 1;

        #tools-filter {
            width: 1fr;
            background: $boost;
        }

        Button {
            width: auto;
            min-width: 0;
            margin: 0 0 0 1;
            padding: 0 1;
        }
    }

    /* fills what the panel has left, so it scrolls to the highlight;
       one line per tool, its description cut at the panel's edge */
    #tools-list {
        height: 1fr;
        max-height: 20;
        text-wrap: nowrap;
        text-overflow: ellipsis;
        padding: 0;
        border: none;
        background: $background;
        scrollbar-size-vertical: 1;

        & > .option-list--option-highlighted {
            color: $accent;
            background: $boost;
        }

        & > .option-list--option-disabled {
            color: $text-muted;
        }

        /* inside the scrollbar, unlike the list's own padding:
           keeps the text off it */
        & > .option-list--option {
            padding: 0 1 0 0;
        }
    }
}
