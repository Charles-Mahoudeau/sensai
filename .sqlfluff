[sqlfluff]
# Set the dialect: postgres, mysql, bigquery, snowflake, tsql, sqlite...
dialect = sqlite
templater = raw

# Like PEP8: 79 characters max
max_line_length = 79

# Rules to ignore (example: ambiguity in column references)
exclude_rules = layout.indent, ambiguous.column_count, structure.column_order

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4
indented_joins = False
indented_using_on = True
implicit_indents = forbid

# Trailing commas, with no space before
[sqlfluff:layout:type:comma]
spacing_before = touch
line_position = trailing

# Comparison operators surrounded by spaces
[sqlfluff:layout:type:comparison_operator]
spacing_within = touch
line_position = leading

[sqlfluff:rules:layout.long_lines]
ignore_comment_lines = True
ignore_comment_clauses = True

# Uppercase keywords, lowercase identifiers (snake_case)
[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

# Explicit aliases with AS
[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

# Final semicolon required, on the same line
[sqlfluff:rules:convention.terminator]
multiline_newline = False
require_final_semicolon = True

# No comma after the last SELECT element
[sqlfluff:rules:convention.select_trailing_comma]
select_clause_trailing_comma = forbid

# Use <> rather than !=
[sqlfluff:rules:convention.not_equal]
preferred_not_equal_style = ansi